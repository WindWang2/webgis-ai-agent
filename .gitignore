# OpenClaw 相关
.openclaw/
.clawhub/
logs/
memory/
/skills/
scripts/
# #671：根级 scripts/ 里只有 ci-local.sh 是提交的 CI 对齐门禁命令，其余仍忽略
!/scripts/
/scripts/*
# frontend/scripts/ 曾被上面的 scripts/ 连带忽略：no-raw-cjk 守卫的
# scan-lib.mjs 因此漏入库，守卫在 CI 从未真正运行（ADR-0144 事故）。
# 该目录承载测试 import 的守卫脚本，必须入库。
!/frontend/scripts/
!/scripts/ci-local.sh
!/scripts/gen_science_catalog.py
!/scripts/gen_api_docs.py
!/scripts/alloc_migration.py
# Science V6 taxonomy 覆盖矩阵审计（Goal 07 Phase A；审计文档的一致性门依赖它）
!/scripts/science_taxonomy_audit.py
!/scripts/gen_science_benchmark_manifest.py
# 工作流目录生成器（test_workflow_guards 的 catalog 一致性门依赖它）
!/scripts/gen_workflow_catalog.py
!/scripts/gen_science_oracles.py
# Quality Platform 生成器（ADR-0104：manifest / drift report / 场景语料，
# 对应的字节一致性闸测试 import 它们，必须入库）
!/scripts/check_tool_descriptor_coverage.py
!/scripts/gen_quality_manifest.py
!/scripts/gen_drift_report.py
!/scripts/gen_trace_certification.py
!/scripts/gen_chaos_registry.py
!/scripts/gen_resource_certification.py
!/scripts/gen_determinism_certification.py
!/scripts/gen_quality_report.py
!/scripts/quality_runner.py
!/scripts/quality
# Recipe eligibility/fallback 覆盖审计（ADR-0151：P0 矩阵 dump + 定期审计门）
!/scripts/recipe_eligibility_audit.py
# Platform V4（ADR-0131）：配置 schema / 依赖 inventory 生成器（字节闸测试
# import 它们，必须入库）。
!/scripts/perf/
!/scripts/gen_config_schema.py
!/scripts/gen_app_inventory.py
# Quality V2（ADR-0118）：staleness 前置检查脚本（generated-artifacts 账本
# 的闸测试引用其退出码语义，必须入库 —— history: check_tool_descriptor_
# coverage.py 漏入库曾使 master 全量收集红）
!/scripts/check_generated_staleness.py
# Quality V3（Epic 10）：协调面脚本 —— preflight / 分配器 / manifest /
# merge-sim / release readiness / 多进程 harness（闸测试 import 或 runner
# 引用，必须入库；history: check_tool_descriptor_coverage.py 漏入库曾使
# master 全量收集红 —— 本白名单 + 入库结构测试就是那场事故的闸）
!/scripts/check_integration_preflight.py
!/scripts/allocate_migration.py
!/scripts/allocate_adr.py
# AC-10 制图质量回归基座（ADR-0159）：本地门禁四件套 + golden/计时工具
# （quality_gate_local.sh 与其步骤脚本、P0 场景计时器；tests/quality 的
# 闸测试与任务书验收依赖它们，必须入库）
!/scripts/quality_gate_local.sh
!/scripts/coverage_cartography_gate.py
!/scripts/quality_ratchet_gate.py
!/scripts/golden_baseline.py
!/scripts/quality_trend_report.py
!/scripts/measure_scenario_timing.py
# AC-10：本地门禁生成的易变产物（golden 基线本体 map.png/golden.json/status.json
# 入库；校验快照与趋势 CSV 每次门禁运行都会重写，不入库）
/docs/dev/ac-10-quality-trend.csv
tests/fixtures/runtime/*/golden/last_verify.json
tests/fixtures/runtime/*/golden/last_failure.json
!/scripts/gen_integration_manifest.py
!/scripts/simulate_merge.py
!/scripts/gen_release_readiness.py
!/scripts/integration_harness.py
!/scripts/gen_frontend_behavior.py
!/scripts/integration_completion_proof.py
# Quality V3：per-branch 工作产物（manifests / merge-sim / import-graph
# 缓存）与 runner 本地状态不入库（审计文档 .md 仍按惯例入库）
.agent-work/integration/
.agent-work/merged-prs-archive/
.agent-work/quality-v3/runner-report.json
.agent-work/quality-v3/runner-report.md
# runner 本地运行状态不入库（V1 历史 + V2 当前）
.agent-work/quality-v1/runner-report.json
.agent-work/quality-v2/runner-report.json
.agent-work/quality-v2/runner-report.md
.agent-work/quality-v1/runner-report.md
# Security manifest 生成器（Wave 15：SECURITY_CONTROLS.md 字节一致性闸依赖）
!/scripts/gen_security_manifest.py
# 端点 scope 矩阵生成器（ADR-0139 P3：矩阵字节闸 + CI 校验依赖；
# history: 漏加本例外曾使脚本被上面 /scripts/* 静默忽略、worktree 清理
# 后丢失，ratchet/preflight 因悬空引用变红 —— 本行就是那场事故的闸）
!/scripts/generate_endpoint_scope_matrix.py
webgis-ai-agent/

