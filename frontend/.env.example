# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Tianditu browser-side token (for tile layers)
NEXT_PUBLIC_TIANDITU_TOKEN=

# Amap JS API key + security key (for browser-side geocoding/POI)
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_JS_SECURITY_KEY=

# 测试阶段免登录开关（true = 未登录也显示全部登录态功能；生产必须移除）
NEXT_PUBLIC_AUTH_DISABLED=false

# ── 离线/内网部署底图（ADR-0197，docs/DEPLOYMENT-offline.md）──────────
# 部署 profile：cloud（默认，历史行为）| air_gapped（只暴露本地底图）
NEXT_PUBLIC_DEPLOYMENT_PROFILE=cloud
# 本地/内网 XYZ 瓦片模板（如 http://tiles.intranet/{z}/{x}/{y}.png）；
# 留空则不注册 local-xyz 底图（诚实缺席，不产生必败瓦片请求）
NEXT_PUBLIC_LOCAL_BASEMAP_URL=
# MapLibre 字形（PBF）服务；离线部署指向内网字体服务
NEXT_PUBLIC_MAP_GLYPHS_URL=
