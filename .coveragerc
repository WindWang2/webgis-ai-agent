[run]
source = app
# TC-16：SQLAlchemy async 经 greenlet 切换执行；缺少 greenlet 并发跟踪时，
# 第一个 await db.execute(...) 之后的代码全部误报为未覆盖（如 auth refresh 路径）。
concurrency = greenlet,thread
omit =
    app/skills/*
    */__pycache__/*
    */migrations/*
    tests/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.
    # 锚定到整行才是"裸 pass 占位"，避免把含 pass 子串的代码行
    # （password/overpass/passed 等敏感标识符行）整块排除出覆盖率分母。
    ^\s*pass\s*$
