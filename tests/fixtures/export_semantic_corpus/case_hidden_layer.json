{
  "name": "case_hidden_layer",
  "description": "与 case_basic_chrome 同构，但 l2（line）visible=False。编译器必须跳过隐藏层（user-wins）：隐藏层几何不得入导出件，否则 extra=fail。",
  "notes": "当前编译器不产出 layer 分组，隐藏层泄漏以 paint 独占颜色指纹探测：l2 的 line-color=#ff00ff 为全 spec 独占色，出现在导出件矢量组即判 extra。",
  "mapspec": {
    "version": "1.1",
    "sources": {
      "s1": {
        "type": "geojson",
        "inlineData": {
          "type": "FeatureCollection",
          "features": [
            {
              "type": "Feature",
              "geometry": { "type": "Point", "coordinates": [116.4, 39.9] },
              "properties": { "name": "站点甲", "v": 12.5 }
            },
            {
              "type": "Feature",
              "geometry": { "type": "Point", "coordinates": [116.44, 39.94] },
              "properties": { "name": "站点乙", "v": 30.1 }
            }
          ]
        }
      }
    },
    "layers": [
      {
        "id": "l1",
        "source": "s1",
        "type": "circle",
        "paint": { "circle-radius": 6, "circle-color": "#3b82f6", "circle-opacity": 0.9 },
        "legend_spec": {
          "type": "categorical",
          "title": "土地覆盖",
          "entries": [
            { "label": "建设用地", "color": "#b35806" },
            { "label": "水体", "color": "#2b70ab" },
            { "label": "林地", "color": "#54278f" }
          ]
        }
      },
      {
        "id": "l2",
        "source": "s1",
        "type": "line",
        "visible": false,
        "paint": { "line-color": "#ff00ff", "line-width": 3 }
      }
    ],
    "layout": {
      "components": [
        { "id": "c-title", "type": "title", "enabled": true, "options": { "text": "研究区专题图" } },
        { "id": "c-subtitle", "type": "subtitle", "enabled": true, "options": { "text": "F14 语义语料 · 隐藏层" } },
        { "id": "c-north", "type": "north_arrow", "enabled": true },
        { "id": "c-scale", "type": "scale_bar", "enabled": true },
        { "id": "c-legend", "type": "legend", "enabled": true, "options": { "layerId": "l1" } },
        { "id": "c-attribution", "type": "attribution", "enabled": true, "options": { "text": "© WebGIS AI Agent 语料" } },
        { "id": "c-graticule", "type": "graticule", "enabled": true }
      ]
    }
  }
}
