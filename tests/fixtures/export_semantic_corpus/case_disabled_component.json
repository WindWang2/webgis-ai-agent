    "layout": {
      "components": [
        { "id": "c-title", "type": "title", "enabled": true, "options": { "text": "研究区专题图" } },
        { "id": "c-subtitle", "type": "subtitle", "enabled": true, "options": { "text": "F14 语义语料 · 组件禁用" } },
        { "id": "c-north", "type": "north_arrow", "enabled": false },
        { "id": "c-scale", "type": "scale_bar", "enabled": true },
        { "id": "c-legend", "type": "legend", "enabled": true, "options": { "layerId": "l1" } },
        { "id": "c-attribution", "type": "attribution", "enabled": true, "options": { "text": "© WebGIS AI Agent 语料" } },
        { "id": "c-graticule", "type": "graticule", "enabled": true }
