{
  "name": "heatmap_native_v15",
  "description": "原生热力（原生键 heatmap-* paint + raster 源兄弟层 —— 开放面照旧）",
  "spec": {
    "version": "1.5",
    "view": {"center": [113.26, 23.13], "zoom": 10},
    "sources": {
      "traces": {"type": "geojson", "inlineData": {"type": "FeatureCollection", "features": []}}
    },
    "layers": [
      {
        "id": "traces_heat",
        "source": "traces",
        "type": "heatmap",
        "paint": {
          "heatmap-weight": 1,
          "heatmap-intensity": ["interpolate", ["linear"], ["zoom"], 0, 0.6, 9, 1.4, 13, 2.2],
          "heatmap-color": ["interpolate", ["linear"], ["heatmap-density"], 0, "rgba(0,0,0,0)", 1, "rgba(255,45,85,1)"],
          "heatmap-radius": ["interpolate", ["linear"], ["zoom"], 0, 2, 9, 30, 13, 51],
          "heatmap-opacity": 0.9
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "effective_version": "1.5",
    "layer_count": 1,
    "unknown_fields": 0,
    "frontend_compile": {
      "layer_id": "traces_heat",
      "paint_key": "heatmap-color",
      "paint_head": "interpolate"
    }
  }
}
