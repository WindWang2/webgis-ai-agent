# ============================================================
# WebGIS AI Agent 生产环境配置
# ============================================================
#
# ⚠️ 安全警告：
# 此文件仅为模板。请将 .env.prod 复制为实际配置
# 确保敏感信息不上传到代码库！
#

# ======== 环境模式 ========
ENV=production
DEBUG=false

# === Core Settings ===
PROJECT_NAME="WebGIS AI Agent (Production)"
DEBUG=false
ENV=production

# Proxy settings (Optional)
HTTP_PROXY=
HTTPS_PROXY=

# ======== JWT/认证密钥（必须修改！）=======
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# ======== 数据库配置 ========
# 本栈自带 db 服务（docker-compose.prod.yml 的 db 服务，容器主机名 db:5432），
# 默认用户/库名 webgis_prod（可被 DB_USER / DB_NAME 覆盖）。注意：DB_PWD 是
# compose 强制键（${DB_PWD:?}，供 db 服务 POSTGRES_PASSWORD 与 exporter 使用），
# DATABASE_URL 里的密码是应用连接串 —— 两个密码必须写成同一个值。
# 完整 DATABASE_URL（应用只读这一项；app/core/config.py 没有 DB_HOST 字段）
# 密码与下方 DB_PWD 必须写成同一个值。
DATABASE_URL=postgresql://webgis_prod:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/webgis_prod

# 方式3: 仅提供密码（compose 强制要求，必须填写）
DB_PWD=CHANGE_ME_STRONG_DB_PASSWORD

# ======== Redis 配置 ========
# compose 强制键（${REDIS_PASSWORD:?}）：redis 服务 --requirepass 与 api/celery
# 的 REDIS_URL（redis://:${REDIS_PASSWORD}@redis:6379/0）都由它注入，必须填写。
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# 以下 URL 仅作示例（compose 按上方 REDIS_PASSWORD 拼好连接串注入容器环境）：
# REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
# CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/1

# ======== 监控（Grafana 管理员）配置 ========
# compose 强制键（${GRAFANA_PWD:?}）：Grafana 初始 admin 密码（用户固定 admin）。必须填写。
GRAFANA_PWD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# ======== 大模型 API 密钥（生产环境必填）=======
# 生产启动时 app/core/config.py 强制校验：留空或占位符 your-api-key-here 会直接报错
LLM_API_KEY=
# 可选：覆盖默认 provider/模型（默认 https://api.stepfun.com/step_plan/v1 / step-3.7-flash）
# LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
# LLM_MODEL=step-3.7-flash

# ======== GitHub 配置（Webhook/PR审查）=======
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN
GITHUB_REPO_OWNER=your-org-or-username
GITHUB_REPO_NAME=webgis-ai-agent

# ======== 飞书通知配置 ========
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-WEBHOOK-ID
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ======== 服务端口配置 ========
API_PORT=8000

# ======== CORS 配置（生产环境必须指定具体域名）=======
CORS_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# ======== 日志级别 ========
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1