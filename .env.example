# WebGIS AI Agent - Environment Variables
# Copy this file to .env and fill in the values

# === Application ===
DEBUG=true
ENV=development

# V9 契约基石（ADR-0138）：统一错误信封。默认 false = 新信封
# {code, success, message, data}；置 true 回退 v1 旧体 {"detail"}（过渡期
# 开关）。请求头 X-Error-Envelope: detail 可按请求覆盖为旧体。
LEGACY_DETAIL_ENVELOPE=false

# Proxy settings (Optional)
HTTP_PROXY=
HTTPS_PROXY=

# === JWT Authentication ===
# Required for persistent sessions. If empty, a random key is generated each startup.
JWT_SECRET_KEY=

# === Database ===
# Local pytest / manage.py (host process, no compose DNS). Unit tests must
# stay on SQLite — do not point the pytest process at compose PostGIS.
DATABASE_URL=sqlite:///./data/webgis.db
#
# Path B: host app + compose db only (mapped 127.0.0.1:15432):
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@localhost:15432/webgis
#
# Path C: docker-compose.yml api/celery ignore this sqlite URL. They inject
# postgresql://postgres:${DB_PASSWORD}@db:5432/webgis (app/core/config.py
# reads DATABASE_URL only; there is no DB_HOST settings field).

# Compose-only credentials (docker-compose.yml uses ${VAR:?} — required to up)
DB_PASSWORD=change-me-dev-db-password
REDIS_PASSWORD=change-me-dev-redis-password

# === LLM (OpenAI-compatible API) ===
# 项目默认 provider：阶跃 Step Plan（https://api.stepfun.com/step_plan/v1）
# 默认模型 step-3.7-flash（推理模型；正文在 content，思维链在 reasoning_content）
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=your-step-plan-api-key
LLM_MODEL=step-3.7-flash

# === Tianditu (天地图) ===
TIANDITU_TOKEN=

# === Chinese Map APIs (高德/百度) ===
AMAP_API_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_KEY=
BAIDU_MAP_AK=

# === 百度千帆 AI Search v2 (网络搜索) ===
# 控制台：https://qianfan.cloud.baidu.com/ → 应用接入 → 创建 API Key
# 格式：bce-v3/ALTAK-xxxxx/yyyyyyyy（拷贝完整字符串作为 Bearer token）
BAIDU_QIANFAN_TOKEN=

# === Sentinel Hub ===
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# === NASA EarthData ===
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# === OpenTopography ===
OPENTOPOGRAPHY_API_KEY=

# === Redis & Celery ===
# 注意：dev compose 对 Redis 强制 requirepass，宿主机进程的 URL 必须带密码
#（容器内由 compose 注入带密码 URL，不受影响）：
REDIS_URL=redis://:change-me-dev-redis-password@localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/0
CELERY_RESULT_BACKEND=redis://localhost:16379/1

# === Development ===
# 开发环境可选：bind-mount 源码到容器实现热重载。
# 设置 WEBGIS_DEV_MOUNT=./app 启用（默认不挂载，避免覆盖镜像代码）。
WEBGIS_DEV_MOUNT=

# 测试阶段免登录开关（true = 免登录，身份 test-admin/admin；生产必须 false）
AUTH_DISABLED=false

# 本地地理数据根目录（ChinaAdminDivisonSHP/ osm_gpkg/ POI/ EXCEL-中国县域统计年鉴（乡镇卷）/
# 的父目录；产物 yearbook/ 与 gd_pois/ 也写在这里；空=未启用）
LOCAL_GEODATA_DIR=
# RAG embedding 模型离线加载（#662）：true=只用本地 HF 缓存，未缓存秒级失败。
# 本地开发保持 false（首用自动下载）；生产镜像/compose 已显式置 true。
RAG_EMBEDDING_OFFLINE=false
# 远程地理工具出网前先查本地 SHP/GPKG（false=始终走在线 API）
LOCAL_QUERY_FIRST=true

# ── E-4（#895）：以下键此前定义于 app/core/config.py 却缺失于本模板 ────────

# LLM
LLM_PLANNER_MODEL=              # 规划阶段独立模型；留空用主模型
LLM_PROMPT_CACHING_ENABLED=true
LLM_NO_PROGRESS_THRESHOLD=3     # 连续 N 轮无进展熔断
# audit4 #997：采样/超时/预算参数（换供应商时按其上限调整，避免 400）
LLM_TIMEOUT_S=120.0             # 非流式请求超时；流式 read = max(180, 1.5×)
LLM_MAX_TOKENS=16384            # 执行角色默认输出预算
LLM_TEMPERATURE=                # 留空 = 不发送（用 provider 默认）
LLM_CONTEXT_WINDOW=            # 上下文窗口 tokens；空 = 服务端默认（Optional）
LLM_TITLE_MODEL=                # 标题/摘要辅助任务廉价模型；空回退 LLM_MODEL

# 额外底图/地图服务密钥（按需）
MAPBOX_TOKEN=
BING_MAP_KEY=
TENCENT_MAP_KEY=

# 生产 CORS（生产模式 fail-fast 校验，逗号分隔来源列表；空=禁止跨域）
CORS_ORIGINS=

# OSM 服务端点（自建镜像/代理时覆盖）
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_API_URL=https://overpass.overpass-api.com/api/interpreter

# 制图质量闭环可调阈值（efd6ddf 的校准面，一般保持默认）
HEATMAP_MIN_POINTS=10
CARTO_LOAD_WARN_RATIO=0.15
CARTO_LOAD_FAIL_RATIO=0.40
CARTO_LABEL_WARN_RATIO=0.10
CARTO_LABEL_FAIL_RATIO=0.25
CARTO_COLOR_SEP_WARN_DELTA_E=10.0
CARTO_COLOR_SEP_FAIL_DELTA_E=5.0
CARTO_VISUALVAR_WARN_COUNT=3
CARTO_VISUALVAR_FAIL_COUNT=4
CARTO_SVS_AREA_PX=2.25
CARTO_DRIFT_RELATIVE_THRESHOLD=0.15
CARTO_DRIFT_NULL_RATIO_THRESHOLD=0.10

# 制图质量事实库（AC-10 / ADR-0159 P1）：落库开关与保留策略
# false 时 record_quality_run 直接短路返回（评审主流程零开销）
CARTO_METRICS_STORE_ENABLED=true
CARTO_METRICS_RETENTION_DAYS=90
CARTO_METRICS_MAX_RUNS=5000

# AC-01 意图语义解析（ADR-0150）：证据加权置信度 + 澄清策略（一般保持默认）
# 权重四分量（task_evidence/slot_completeness/entity_quality/session_consistency），
# 加权和经语料校准锚点映射到最终置信度
INTENT_CONF_W_TASK=0.40
INTENT_CONF_W_SLOTS=0.25
INTENT_CONF_W_ENTITY=0.20
INTENT_CONF_W_SESSION=0.15
# 低于此置信度触发澄清（下游合成阈值 0.65 不受此影响）
INTENT_CLARIFY_CONFIDENCE_FLOOR=0.55
# 实体解析行政区服务开关（local_first）；false = 仅词表快路径
INTENT_ENTITY_SERVICE=true

# Data Fabric 抓取预算
DATA_FABRIC_QUERY_TIMEOUT=30.0
DATA_FABRIC_TOTAL_QUERY_TIMEOUT=120.0
DATA_FABRIC_MAX_PAGES=200
DATA_FABRIC_MAX_RESPONSE_BYTES=268435456
DATA_FABRIC_MAX_FEATURES=50000
DATA_FABRIC_SYNC_CONCURRENCY=4
DATA_FABRIC_LOCAL_FILE_ROOTS=./data
DATA_FABRIC_LOCAL_FILE_MAX_BYTES=1073741824
# Data Fabric V7 联邦数据面（ADR-0119）—— 全部有界治理参数
DATA_FABRIC_V7_CONNECTION_MAX_ENTRIES=1024
DATA_FABRIC_V7_CONNECTION_IDLE_TTL_S=1800.0
DATA_FABRIC_V7_PROBE_TTL_S=300.0
DATA_FABRIC_V7_RESULT_CACHE_MAX_ENTRIES=256
DATA_FABRIC_V7_RESULT_CACHE_MAX_BYTES=67108864
DATA_FABRIC_V7_RESULT_CACHE_TTL_S=300.0
DATA_FABRIC_V7_FEEDBACK_MAX_ROWS=20000

# Data Fabric V8 自适应联邦（ADR-0132）—— 引擎熔断 + 结果缓存 stampede/后端
DATA_FABRIC_V8_ENGINE_BREAKER_THRESHOLD=3
DATA_FABRIC_V8_ENGINE_BREAKER_COOLDOWN_S=60.0
DATA_FABRIC_V8_RESULT_CACHE_SINGLEFLIGHT_WAIT_S=10.0
DATA_FABRIC_V8_RESULT_CACHE_BACKEND=memory
DATA_FABRIC_V8_RESULT_CACHE_REDIS_URL=


# 存储位置
DATA_DIR=./data
TMP_DIR=./tmp
# 项目产物内容寻址存储根（ADR-0092 A3 artifact promotion）。空 = DATA_DIR/project_artifacts。
PROJECT_ARTIFACT_CONTENT_DIR=
# 仓内 vendor/pi（JSON-RPC 子进程）。true=项目启动即拉起 bundled Pi。
# false=紧急回退 ChatEngine。测试套件在 conftest 钉 false。
USE_NEW_AGENT=true
USE_REDIS=true

# E-9（#900）：运行期行为参数（登记于 Settings；lazy env 读兼容测试）
RASTER_PROCESSING_MEMORY_MB=256
RASTER_GDAL_CACHE_MAX_MB=64
ALLOW_PUBLIC_REGISTER=false      # 生产环境为 true 时启动直接拒绝
TOOL_TIMEOUT_S=300
SESSION_CACHE_SIZE=200
SESSION_MESSAGE_CAP=200
CLEAR_QUIESCE_TIMEOUT_S=5.0
CANCEL_WAIT_TIMEOUT_S=5.0
CHAT_MAX_ROUNDS=60
TURN_TOTAL_TIMEOUT_S=900

# Pi bridge worker pool size (V5-B, production-routed). Sessions get stable
# affinity (md5(session_id) % N): same session stays strictly ordered on its
# worker; sessions hashing to DIFFERENT workers can run in parallel (two
# sessions colliding onto one worker serialize there). Resource cost: ONE
# full vendor/pi node subprocess + RPC reader task per worker (each processes
# one prompt at a time). Recommended default stays 1 — raise only if
# concurrent multi-session load justifies the extra processes, and raise
# TOOL_WAVE_CONCURRENCY too if tool-heavy sessions dominate (tool execution
# shares one process-wide wave semaphore).
#PI_BRIDGE_POOL_SIZE=1

# ── GIS Extension Platform（ADR-0104）────────────────────────────────────
# 默认全关：不配置 EXTENSIONS_DIRS 时启动行为与旧版完全一致。
# EXTENSIONS_DIRS: os.pathsep 冒号分隔的扩展根目录列表（<root>/<ext>/manifest.json）
# EXTENSIONS_ALLOW/BLOCK: 逗号分隔的扩展 id 信任白/黑名单（block 优先）
# EXTENSIONS_BUILTIN_IDS: 随仓库发行的受信扩展包 id（逗号分隔）
# EXTENSION_PERMISSION_GRANTS: "id:perm1,perm2;id2:perm3" 形式的授权表
# EXTENSION_FEATURE_FLAGS / EXTENSION_SETTINGS_JSON: 按 extension id 的 JSON object 覆盖
EXTENSIONS_ENABLED=false
EXTENSIONS_DIRS=
EXTENSIONS_ALLOW=
EXTENSIONS_BLOCK=
EXTENSIONS_BUILTIN_IDS=
EXTENSION_PERMISSION_GRANTS=
EXTENSIONS_ACTIVATE_UNTRUSTED=false
EXTENSION_FEATURE_FLAGS={}
EXTENSION_SETTINGS_JSON={}
# ── V2（ADR-0105）：隔离执行 / 供应链。默认全部关闭/为空 = V1 行为 ──
# EXTENSION_SECRETS_JSON: {extension_id: {ref: value}}；供给即授权，值只经
#   broker 送达对应扩展，不进入状态/日志/LLM 可见面
# EXTENSION_NETWORK_ALLOW: "id:host1,host2;id2:*" 形式的出网 allowlist
#   （worker broker 的 network 能力默认 deny；按 host 匹配）
# EXTENSION_ARTIFACT_ROOTS: os.pathsep 分隔的 artifact 根目录（worker broker
#   的 artifact_read/write 仅限根内路径；空 = 拒绝全部）
# EXTENSION_TRUSTED_PUBLISHERS: "key_id:keyfile_path,..." 发布者密钥表
# EXTENSIONS_TRUST_SIGNED: 验签通过且发布者受信 → 提权 trusted_extension
# EXTENSIONS_ALLOW_UNSIGNED_DEV: 未签名包的显式开发模式（大声告警）
# EXTENSIONS_MAX_WORKER_CRASHES: worker 连续崩溃达到该值 → quarantine
EXTENSION_SECRETS_JSON={}
EXTENSION_NETWORK_ALLOW=
EXTENSION_ARTIFACT_ROOTS=
EXTENSION_TRUSTED_PUBLISHERS=
EXTENSIONS_TRUST_SIGNED=false
EXTENSIONS_ALLOW_UNSIGNED_DEV=false
EXTENSIONS_MAX_WORKER_CRASHES=2
# ── V3（ADR-0109）：分发市场、版本钉扎与流式窗口 ──
EXTENSION_TRUST_STORE_PATH=
EXTENSION_REGISTRY_DIR=
EXTENSION_REGISTRY_URLS=
EXTENSIONS_INSTALL_ROOT=
EXTENSIONS_ISOLATION_BACKEND=process
EXTENSION_VERSION_PIN=
EXTENSIONS_KEEP_VERSIONS=3
EXTENSION_STREAM_WINDOW=16
EXTENSION_MAX_STREAM_EVENTS=10000
# STAC 目录（卫星影像检索，extensions/ogc 集成与默认数据面共用）
STAC_API_URL=https://earth-search.aws.element84.com/v1

# ── Spatial Lakehouse V6（ADR-0118）──────────────────────────────────────
# 对象存储后端（BlobStore 的第二实现；默认 filesystem = 行为零变化）。
# WEBGIS_OBJECT_STORE_BACKEND: filesystem | s3
# s3 后端需配置 endpoint/bucket（MinIO 等兼容端点均可）；凭据不配置时走
# 环境默认凭证链。WEBGIS_S3_PREFIX 可选：同 bucket 内多部署隔离。
WEBGIS_OBJECT_STORE_BACKEND=filesystem
WEBGIS_S3_ENDPOINT_URL=
WEBGIS_S3_BUCKET=
WEBGIS_S3_REGION=
WEBGIS_S3_ACCESS_KEY_ID=
WEBGIS_S3_SECRET_ACCESS_KEY=
WEBGIS_S3_PREFIX=

# ── Spatial ModelOps & GeoAI Inference V2（ADR-0119）─────────────────────
# 模型注册表/复用缓存根目录（默认 data/modelops）。
MODELOPS_REGISTRY_DIR=
# 进程内 loaded 模型数上界（LRU 驱逐）与内存记账预算（bytes）。
MODELOPS_MAX_LOADED_MODELS=4
MODELOPS_VRAM_BUDGET_BYTES=8589934592
# 并发推理运行上界（引擎线程池大小）与默认墙钟 deadline（秒）。
MODELOPS_MAX_CONCURRENT_INFERENCES=2
MODELOPS_INFERENCE_DEADLINE_S=600
# 推理复用缓存上界。
MODELOPS_REUSE_MAX_ENTRIES=128
MODELOPS_REUSE_MAX_BYTES=2147483648
# remote 推理端点 allowlist（逗号分隔，scheme://host:port 精确匹配；
# 默认空 = 全部拒绝——remote provider 是 opt-in 面）。
MODELOPS_REMOTE_ALLOWLIST=
# V3 §B 本地子进程推理 worker allowlist（slot=/绝对路径/worker.py 逗号分隔；
# 默认空 = 子进程通道关闭；脚本由 operator 登记与管理，不来自模型包）。
MODELOPS_SUBPROCESS_WORKERS=
# 子进程单批推理 deadline（秒；超时 kill 进程）。
MODELOPS_SUBPROCESS_DEADLINE_S=120
# V3 §D 矢量产物 PostGIS 发布通道（SQLAlchemy DSN；默认空 = 关闭，
# GeoJSON 文件产物不受影响）。
MODELOPS_POSTGIS_DSN=
# V3 §E warm pool：常驻加载的模型 id（逗号分隔；启动时钉进 loaded cache，
# 防 LRU 驱逐——提升连续推理的首次延迟）。
MODELOPS_WARM_POOL=
