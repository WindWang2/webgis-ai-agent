# ============================================================
# WebGIS AI Agent 生产环境 Dockerfile
# 多阶段构建，使用 Next.js standalone 输出
# ============================================================

# Stage 1: Frontend Dependencies
FROM node:26-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS frontend-deps
WORKDIR /app/frontend

# pnpm 是唯一包管理器（audit5 #1083：npm lockfile 已删除）。Node 25+
# 不再内置 Corepack；用 npm 显式安装固定 pnpm 版本（应用仍由 pnpm 安装）。
# node:26：jest-dom@7 / jsonlint-lines-primitives@2.0.3 等要求 node >=22（engine-strict）。
RUN npm install --global pnpm@10.15.1
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prefer-offline

# Stage 2: Frontend Builder
FROM node:26-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS frontend-builder
WORKDIR /app/frontend
RUN npm install --global pnpm@10.15.1
COPY --from=frontend-deps /app/frontend/node_modules ./node_modules
COPY frontend/ ./

# transport goal E-F-2 (P0): NEXT_PUBLIC_* is inlined into the browser bundle
# at BUILD time. Without this ARG the bundle defaulted to http://localhost:8001,
# so in any standard deployment every API call (incl. chat SSE) hit the user's
# own machine and the app was dead. Default "" -> same-origin (relative) URLs,
# which is correct behind the bundled nginx reverse proxy; override for a
# cross-origin backend. config.ts uses ?? so an explicit empty string wins over
# the dev fallback.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# F-04: "" -> collab WebSocket derives ws(s)://<page host> at runtime (nginx
# /api/v1/ws/ location) instead of the dev fallback; override for a
# cross-origin backend.
ARG NEXT_PUBLIC_WS_URL=""
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
# Optional public browser key; enables the credential-gated CARTO profiles.
ARG NEXT_PUBLIC_CARTO_BASEMAP_KEY=""
ENV NEXT_PUBLIC_CARTO_BASEMAP_KEY=$NEXT_PUBLIC_CARTO_BASEMAP_KEY

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_RUNTIME=nodejs
RUN pnpm run build

# Stage 2b: Node runtime for the runner stage
# PLT-03：Debian bookworm 的 `nodejs` apt 包是 18.x，而 Next 16 要求
# >=20.9（Next.js 16 运行时要求；CVE 修复也要求新版）。从官方
# node:26-bookworm-slim（与 runner 同 glibc 基线；alpine 的 musl 二进制
# 不可用）只复制 node 单二进制 —— 运行时只需 `node server.js` 与 Pi RPC
# 的 `node rpc-entry.js`，npm/corepack 不入镜像以控制体积。
FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS node-runtime

# Stage 2c: Pi RPC runtime builder（goal-pi-native-host-vnext / #400 根因清偿）
# 此前镜像只 COPY vendor/ 源码而从未构建 dist —— USE_NEW_AGENT=true 时
# bridge 找不到 rpc-entry.js 而静默回退旧引擎。Pi v1.5.0 的 RPC bundle
# 仍需锁定的外部 jiti 加载 WebGIS 扩展；两者一起复制到运行镜像。
# 本地等价命令：scripts/build-vendor-pi.sh。
FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS pi-builder
WORKDIR /app
# 层缓存次序：先 manifest + npm ci（源码不变时命中缓存），再拷源码构建。
COPY vendor/pi/package.json vendor/pi/package-lock.json ./vendor/pi/
RUN cd vendor/pi && npm ci --no-audit --no-fund && rm -rf node_modules
COPY vendor/pi/ ./vendor/pi/
RUN cd vendor/pi && npm ci --no-audit --no-fund && npm run build \
    && test -f packages/coding-agent/dist/bundle/rpc-entry.js

# Stage 3: Backend Python Dependencies
# 与 .python-version / requirements.lock 及下方 site-packages COPY 保持 3.12；
# bookworm 与 GDAL runtime 包名及 node-runtime 的 glibc 基线一致。
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS backend-deps
WORKDIR /app/backend

# Install GDAL/GEOS/PROJ system libraries required by rasterio, pyogrio, geopandas
RUN apt-get update && apt-get install -y --no-install-recommends \
    libexpat1 libgdal-dev gdal-bin libgeos-dev libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# audit ISSUE-033（#1340）：安装面以 uv 编译的 requirements.lock 为准 ——
# 同 SHA 重建得到同一依赖树，不再每次解析当时最新版。
COPY requirements.txt requirements.lock .
RUN pip install --no-cache-dir --break-system-packages \
    uv==0.5.11 \
    && uv pip install --system --no-cache -r requirements.lock

# Stage 4: Final Runner
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS runner
WORKDIR /app/backend

# #662：生产容器离线加载 RAG embedding 模型 —— 未缓存时首用秒级失败（有界），
# 而不是无超时的 HF 下载挂死 worker 线程/优雅关停。模型缓存预置见
# docs/DEPLOYMENT.md（HF_HOME 卷预热或构建期下载）。
ENV RAG_EMBEDDING_OFFLINE=true

# Install tini and GDAL/GEOS/PROJ runtime libraries. Node 26 comes from the
# node-runtime stage (NOT Debian's nodejs 18 package — PLT-03); libstdc++6 is
# the shared lib the official Node binary links against.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini libgdal32 libgeos-c1v5 libproj25 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# PLT-03: official Node 26 binary (FROM node:26-bookworm-slim above).
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

# Copy frontend standalone output.
# Next standalone 的 server.js 相对自身目录解析静态资源：
# <standalone>/.next/static 与 <standalone>/public（#1706：此前 static/public
# 落在 standalone 目录之外，容器内 /_next/static/* 与 /public 全部 404，
# 前端是无 JS/CSS 的空壳，而 /health 仍绿）。
COPY --from=frontend-builder /app/frontend/.next/standalone ./frontend/.next/standalone
COPY --from=frontend-builder /app/frontend/.next/static ./frontend/.next/standalone/.next/static
COPY --from=frontend-builder /app/frontend/public ./frontend/.next/standalone/public
# 构建期断言：摆错即构建失败，防复发（复制失败时 Docker COPY 本身会报错）。
RUN test -d frontend/.next/standalone/.next/static && test -d frontend/.next/standalone/public

# Copy Python packages
COPY --from=backend-deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=backend-deps /usr/local/bin /usr/local/bin

# Copy application code (审计 I7：之前 COPY . . 会把 screenshots / 进度文档 /
# 测试 / planning artifacts 全带进 runner 镜像，bloat + 内部信息泄漏)。
COPY main.py ./
# #587：镜像必须携带 manage.py —— 公开注册默认关闭（ALLOW_PUBLIC_REGISTER=false），
# 首个 admin 只能通过 `python manage.py create-admin` 创建；镜像缺此文件则所有
# 生产形态首次部署后无任何 admin 引导通道。
COPY manage.py ./
COPY app/ ./app/
COPY skills-lock.json ./
COPY alembic.ini ./
COPY migrations/ ./migrations/
# #476: 镜像一直带着 alembic.ini + migrations/ 却没有任何路径执行它 ——
# 存量 Postgres 升级部署后 schema 停留在首次创建状态。entrypoint 在启动
# CMD 前跑 `alembic upgrade head`（幂等；SKIP_DB_MIGRATIONS=true 可跳过，
# celery-worker 服务用，避免与 api 并发 upgrade 竞争 alembic_version）。
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
# #400: pi RPC 入口是仓库相对路径 vendor/pi/packages/coding-agent/dist/（pi_rpc_client
# 解析顺序 bundle → dist）。CI 以 submodules:recursive 检出；自 pi-builder 阶段起
# 构建产物随镜像分发 —— USE_NEW_AGENT=true 不再静默回退旧引擎。
COPY vendor/ ./vendor/
COPY --from=pi-builder /app/vendor/pi/packages/coding-agent/dist/bundle ./vendor/pi/packages/coding-agent/dist/bundle
COPY --from=pi-builder /app/vendor/pi/node_modules/jiti ./vendor/pi/node_modules/jiti

# Create non root user
RUN groupadd --system --gid 1001 appgroup && \
    useradd --system --uid 1001 --gid appgroup --shell /bin/false --home /app appuser && \
    # /app/data 必须在镜像内预建并归 appuser：命名卷（webgis_data）挂载到
    # 镜像中不存在的路径时，Docker 以 root 创建挂载点，非 root 进程
    # makedirs(DATA_DIR/exports) 直接 EACCES（api 起不来，preview 健康检查
    # 502）。空命名卷首次挂载会从镜像复制目录属主，预建即修复。
    mkdir -p /app/uploads /app/data /app/.pi /app/.cache && \
    # security F-16：应用代码保持 root 属主只读 —— 此前 chown -R /app 让运行
    # 用户拥有全部 Python 源码，任一 RCE/任意写可改源码持久化。只把运行期
    # 必须可写的路径交给 appuser：DATA_DIR、uploads、HOME 下缓存、技能上传目录。
    chown -R appuser:appgroup /app/uploads /app/data /app/.pi /app/.cache \
        /app/backend/app/skills

USER appuser

EXPOSE 3000 8000

# #400: 容器同时跑 uvicorn:8000 与 node:3000 —— 两个进程都要探测，否则
# node 挂掉时容器仍"健康"，nginx 对前端 502 而编排层毫无感知。
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request as u; u.urlopen('http://localhost:8000/api/v1/health/live', timeout=5); u.urlopen('http://localhost:3000/', timeout=5)" || exit 1

# #476: tini 仍是 PID 1（信号收割），entrypoint 在 exec CMD 前执行
# `alembic upgrade head`（迁移失败 = 容器失败，不带旧 schema 起服务）。
ENTRYPOINT ["tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
# The supervisor forwards shutdown to both service groups and exits if either
# service stops; a surviving sibling cannot conceal a failed container.
# Its uvicorn command enforces the 16KiB WebSocket frame boundary.
CMD ["python", "-m", "app.lib.runtime.service_supervisor"]
