{
  "additionalProperties": true,
  "description": "D3：一次降级/换源的决策记录（与 ADR-0151 制图面同构、命名空间独立）。\n\n``comparable=False`` 时下游**必须**在产物标注「结果不可比」（任务书 §2/§3-DS4\n硬约束）；静默换源是被禁止的。",
  "properties": {
    "trigger": {
      "enum": [
        "timeout",
        "5xx",
        "429",
        "quota",
        "empty_result",
        "truncated",
        "schema_mismatch",
        "circuit_open",
        "probe_failed",
        "other"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "from_source": {
      "title": "From Source",
      "type": "string"
    },
    "to_source": {
      "title": "To Source",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "comparable": {
      "default": false,
      "title": "Comparable",
      "type": "boolean"
    },
    "degradation_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degradation Notes"
    },
    "decided_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    }
  },
  "required": [
    "trigger",
    "from_source",
    "to_source",
    "reason"
  ],
  "title": "FallbackDecision",
  "type": "object",
  "$id": "https://webgis-ai-agent.local/schemas/ads-v1/d3_fallback_decision.schema.json",
  "x-ads-contract-version": "1.0"
}
