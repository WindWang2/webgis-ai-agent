      "default": null,
      "title": "Bbox"
    },
    "feature_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Count"
    },
    "fields": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Fields",
      "type": "array"
    },
    "schema_fields": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Schema Fields",
      "type": "object"
    },
    "query_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Query Capabilities",
      "type": "array"
    },
    "style_hints": {
      "additionalProperties": true,
      "title": "Style Hints",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "contract_version": {
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "version": {
      "default": "latest",
      "title": "Version",
      "type": "string"
    },
    "version_pinned": {
