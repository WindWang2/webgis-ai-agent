  "required": [
    "id"
  ],
  "title": "D1DatasetDescriptor",
  "type": "object",
  "$id": "https://webgis-ai-agent.local/schemas/ads-v1/d1_dataset_descriptor.schema.json",
  "x-ads-contract-version": "1.0"
