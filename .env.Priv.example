# ============================================================
# WebGIS AI Agent — 生产环境私密凭证模板
# ⚠️  本模板仅含占位符（change_me_...），不含真实密码。复制为 .env.Priv 并填写真实值。
#     .env.Priv 已加入 .gitignore，不会被 git 追踪。
# ============================================================

# 数据库密码（PostgreSQL）— 必须与 docker-compose.prod.secure.yml 中
# db 服务的 POSTGRES_PASSWORD 一致。
DB_PWD=change_me_to_a_strong_password_32chars_min

# Redis 密码 — 必须与 redis 服务 --requirepass 一致。
REDIS_PASSWORD=change_me_to_a_strong_password_32chars_min

# JWT 签名密钥 — 生产环境必须使用高熵随机字符串（至少 32 字符）。
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_very_strong_random_secret_key_at_least_32_chars

# CORS 允许来源（生产环境禁止 ["*"]）。settings.CORS_ORIGINS 是 List[str]，
# 环境变量必须是 JSON 数组格式（逗号分隔的纯字符串无法通过 pydantic 解析，
# api 会启动失败）。
# 示例: CORS_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]
CORS_ORIGINS=["https://your-domain.com"]
